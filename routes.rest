// LOCALHOST 
http://localhost:3000/
http://localhost:3000/login
http://localhost:3000/logout
http://localhost:3000/profile

### GET API-DOCS
GET http://localhost:3000/api-docs HTTP/1.1

### GET all magazine
GET http://localhost:3000/magazine/ HTTP/1.1

### GET magazine by id
GET http://localhost:3000/magazine/64a05c66115b238db392355e HTTP/1.1

### CREATE magazine
POST http://localhost:3000/magazine HTTP/1.1 content-type: application/json

{
"magazineKey": 98, 
"title": "Victors Book", 
"category": ["Entertainment", "Travel"], 
"price": 15.05, 
"pubDate" : {
	"$date": "2011-03-01T08:00:00.000Z"
    },
"publisher": "victor.media", 
"url": "abc-subscription.media/victorsbook.com"
}

### CHANGE magazine by id
PUT http://localhost:3000/magazine/64a05c66115b238db392355e HTTP/1.1 content-type: application/json

{
"publisher": "High Renaissance"
}

### DELETE magazine by id
DELETE http://localhost:3000/magazine/64af6842e6c0b4f585c6dc69 HTTP/1.1

